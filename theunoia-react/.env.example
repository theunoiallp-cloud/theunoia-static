# ==============================================================================
# THEUNOiA — Supabase Client Configuration (.env.example)
# ==============================================================================
# In your Supabase Project Dashboard -> Project Settings -> API:
# 1. Copy your Project URL into VITE_SUPABASE_URL
# 2. Copy your anon / publishable API key into VITE_SUPABASE_PUBLISHABLE_KEY
#
# NOTE: Never expose your service_role secret key in frontend environment variables.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
