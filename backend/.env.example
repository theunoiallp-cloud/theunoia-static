# THEUNOiA Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Location of persistent SQLite database
# On Linux VPS: /var/lib/theunoia/theunoia.db
DATABASE_PATH=./data/theunoia.db

# Backup location
# On Linux VPS: /var/backups/theunoia
BACKUP_PATH=./backups

# Allowed CORS origins (comma-separated). Set your production Vercel domain and custom domain here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://theunoia.com,https://www.theunoia.com

# Initial admin password seeded ONLY on first initialization into SQLite with bcrypt
ADMIN_INITIAL_PASSWORD=change_this_to_a_secure_password_in_production
TURSO_DATABASE_URL=libsql://theunoia-db-theunoia.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJqdGkiOiJXd1FWSnN2REVmR0E1RXJNa2dmZ29nIiwib3JnX2lkIjoxMDAwMjc3NjI1fQ.yH6HK7ScLKJvhD1gec-EiYPN3x42xKryff7PHD05-snyKaba5a1ew1G8khu17rBSbVvQEUsynY0wES-OWr0wDw
