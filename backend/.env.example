# THEUNOiA Backend Environment Configuration

# Server Port (Local dev)
PORT=4000
NODE_ENV=development

# --- DATABASE CONFIGURATION ---
# Option A: Remote Persistent Database on Vercel (Turso / libSQL)
TURSO_DATABASE_URL=libsql://[your-database-name]-[your-org].turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Option B: Local SQLite file (Fallback when TURSO_DATABASE_URL is not set)
DATABASE_PATH=./data/theunoia.db

# Backup location (local mode)
BACKUP_PATH=./backups

# Allowed CORS origins (comma-separated). On unified Vercel deployment, same-origin /api is allowed automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://theunoia.com,https://www.theunoia.com

# Initial admin password seeded ONLY on first initialization into database with bcrypt
ADMIN_INITIAL_PASSWORD=change_this_to_a_secure_password_in_production
