{
  "name": "theunoia-backend",
  "version": "1.0.0",
  "description": "Backend API and Admin system for THEUNOiA with SQLite",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-db": "node src/scripts/init-db.js",
    "set-admin-password": "node src/scripts/set-admin-password.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
